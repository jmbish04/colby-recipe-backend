{
  "name": "cognitive-kitchen-backend",
  "version": "1.0.0",
  "description": "Cognitive Kitchen - AI-powered recipe and menu management backend (Cloudflare Workers)",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "deploy": "npm run db:generate && npm run db:migrate:remote && wrangler deploy",
    "deploy:ci": "npm ci && npm run db:generate && npm run db:migrate:remote && wrangler deploy",
    "typecheck": "wrangler types && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:create": "npx prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script --output prisma/migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:studio": "prisma studio",
    "db:push": "prisma db push",
    "wrangler:types": "wrangler types"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "hono",
    "prisma",
    "d1",
    "recipes",
    "ai",
    "durable-objects",
    "agents",
    "openapi"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@hono/swagger-ui": "^0.5.0",
    "@hono/zod-openapi": "^0.18.3",
    "@prisma/adapter-d1": "^6.1.0",
    "@prisma/client": "^6.1.0",
    "agents": "^0.0.77",
    "hono": "^4.9.9",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241230.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "prisma": "^6.1.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wrangler": "^4.42.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  }
}
